{
  "headers": [
    {
      "source": "/audio/(.*)\\.mp3",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(course\\.json|audio/manifest\\.json|app\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/stt.js": {
      "includeFiles": "node_modules/kuromoji/dict/**"
    },
    "api/chat.js": {
      "maxDuration": 30
    }
  }
}
