  {
   "id": "u1",
   "title": "Saludos",
   "en": "Greetings",
   "note": "`¿Cómo estás?` is for one person you know. `¿Cómo está usted?` is formal. `¿Cómo estáis?` is for a group of friends and is used every day in Spain.",
   "dialogue": [
    {
     "speaker": "Ana",
     "target": "Hola, buenos días.",
     "en": "Hi, good morning."
    },
    {
     "speaker": "Leo",
     "target": "Buenos días. ¿Cómo estás?",
     "en": "Good morning. How are you?"
    },
    {
     "speaker": "Ana",
     "target": "Muy bien, gracias. ¿Y tú?",
     "en": "Really good, thanks. And you?"
    },
    {
     "speaker": "Leo",
     "target": "Bien también. ¿Cómo te llamas?",
     "en": "Good too. What's your name?"
    },
    {
     "speaker": "Ana",
     "target": "Me llamo Ana. ¿Y tú?",
     "en": "My name's Ana. And you?"
    },
    {
     "speaker": "Leo",
     "target": "Me llamo Leo. Mucho gusto.",
     "en": "My name's Leo. Nice to meet you."
    },
    {
     "speaker": "Ana",
     "target": "Encantada. Hasta luego.",
     "en": "Nice to meet you too. See you later."
    },
    {
     "speaker": "Leo",
     "target": "Adiós, hasta luego.",
     "en": "Bye, see you later."
    }
   ],
