   "id": "u1",
   "title": "Saluti",
   "en": "Greetings",
   "note": "`Come stai?` is for one person you know. `Come sta?` is the polite form for a stranger (`Lei`). `Come state?` is for a group. `Ciao` means both hello and bye among friends; say `Buongiorno` until mid-afternoon and `Buonasera` after that.",
   "dialogue": [
    {
     "speaker": "Giulia",
     "target": "Ciao, buongiorno.",
     "en": "Hi, good morning."
    },
    {
     "speaker": "Leo",
     "target": "Buongiorno. Come stai?",
     "en": "Good morning. How are you?"
    },
    {
     "speaker": "Giulia",
     "target": "Bene, grazie. E tu?",
     "en": "Fine, thanks. And you?"
    },
    {
     "speaker": "Leo",
     "target": "Anch'io bene. Come ti chiami?",
     "en": "I'm fine too. What's your name?"
    },
    {
     "speaker": "Giulia",
     "target": "Mi chiamo Giulia. E tu?",
     "en": "My name is Giulia. And you?"
    },
    {
     "speaker": "Leo",
     "target": "Mi chiamo Leo. Piacere.",
     "en": "My name is Leo. Nice to meet you."
    },
    {
     "speaker": "Giulia",
     "target": "Piacere mio. A dopo!",
     "en": "The pleasure is mine. See you later!"
    },
    {
     "speaker": "Leo",
     "target": "Ciao, a dopo.",
     "en": "Bye, see you later."
    }
   ],
