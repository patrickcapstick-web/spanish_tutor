  {
   "id": "u2",
   "title": "¿De dónde eres?",
   "en": "Where are you from?",
   "noteHtml": "The verb <code>ser</code> says who you are and where you are from: <code>soy, eres, es, somos, sois, son</code>. Spanish usually drops the pronoun because the verb ending already says who.",
   "dialogue": [
    {
     "speaker": "Ana",
     "es": "¿De dónde eres, Leo?",
     "en": "Where are you from, Leo?"
    },
    {
     "speaker": "Leo",
     "es": "Soy de Estados Unidos. ¿Y tú?",
     "en": "I am from the United States. And you?"
    },
    {
     "speaker": "Ana",
     "es": "Soy de Madrid. ¿Eres estudiante?",
     "en": "I am from Madrid. Are you a student?"
    },
    {
     "speaker": "Leo",
     "es": "No, soy ingeniero.",
     "en": "No, I am an engineer."
    },
    {
     "speaker": "Ana",
     "es": "¿Y tus amigos? ¿Son de aquí?",
     "en": "And your friends? Are they from here?"
    },
    {
     "speaker": "Leo",
     "es": "No, son de Inglaterra.",
     "en": "No, they are from England."
    },
    {
     "speaker": "Ana",
     "es": "¿Sois turistas?",
     "en": "Are you all tourists?"
    },
    {
     "speaker": "Leo",
     "es": "Sí, somos turistas.",
     "en": "Yes, we are tourists."
    }
   ],
