  {
   "id": "u1",
   "title": "Saludos",
   "en": "Greetings",
   "noteHtml": "<code>¿Cómo estás?</code> is for one person you know. <code>¿Cómo está usted?</code> is formal. <code>¿Cómo estáis?</code> is for a group of friends and is used every day in Spain.",
   "dialogue": [
    {
     "speaker": "Ana",
     "es": "Hola, buenos días.",
     "en": "Hello, good morning."
    },
    {
     "speaker": "Leo",
     "es": "Buenos días. ¿Cómo estás?",
     "en": "Good morning. How are you?"
    },
    {
     "speaker": "Ana",
     "es": "Muy bien, gracias. ¿Y tú?",
     "en": "Very well, thanks. And you?"
    },
    {
     "speaker": "Leo",
     "es": "Bien también. ¿Cómo te llamas?",
     "en": "Fine too. What is your name?"
    },
    {
     "speaker": "Ana",
     "es": "Me llamo Ana. ¿Y tú?",
     "en": "My name is Ana. And you?"
    },
    {
     "speaker": "Leo",
     "es": "Me llamo Leo. Mucho gusto.",
     "en": "My name is Leo. Nice to meet you."
    },
    {
     "speaker": "Ana",
     "es": "Encantada. Hasta luego.",
     "en": "Pleased to meet you. See you later."
    },
    {
     "speaker": "Leo",
     "es": "Adiós, hasta luego.",
     "en": "Goodbye, see you later."
    }
   ],
