   "id": "u3",
   "title": "En el bar",
   "en": "At the bar",
   "noteHtml": "<code>querer</code> (to want): <code>quiero, quieres, quiere, queremos, queréis, quieren</code>. Use <code>un</code> with masculine nouns and <code>una</code> with feminine ones. A <code>caña</code> is a small draught beer.",
   "dialogue": [
    {
     "speaker": "Camarero",
     "es": "Hola, ¿qué te pongo?",
     "en": "Hi, what can I get you?"
    },
    {
     "speaker": "Leo",
     "es": "Quiero un café con leche, por favor.",
     "en": "I want a coffee with milk, please."
    },
    {
     "speaker": "Camarero",
     "es": "¿Algo más?",
     "en": "Anything else?"
    },
