     "speaker": "Camarero",
     "es": "Son tres euros con cincuenta.",
     "en": "It is three euros fifty."
    },
    {
     "speaker": "Leo",
     "es": "Aquí tienes. Gracias.",
     "en": "Here you go. Thanks."
    }
   ],
