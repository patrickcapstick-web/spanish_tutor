     "speaker": "Leo",
     "es": "¿Está lejos de aquí?",
     "en": "Is it far from here?"
    },
    {
     "speaker": "Ana",
     "es": "No, está a cinco minutos.",
     "en": "No, it is five minutes away."
    },
    {
     "speaker": "Leo",
     "es": "¿Hay una farmacia por aquí?",
     "en": "Is there a pharmacy around here?"
    },
    {
     "speaker": "Ana",
     "es": "Sí, hay una a la izquierda, al lado del banco.",
     "en": "Yes, there is one on the left, next to the bank."
    },
    {
     "speaker": "Leo",
     "es": "Muchas gracias.",
     "en": "Thank you very much."
    },
    {
     "speaker": "Ana",
     "es": "De nada.",
     "en": "You are welcome."
    }
   ],
