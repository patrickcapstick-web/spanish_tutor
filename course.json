  {
   "id": "u4",
   "title": "¿Dónde está?",
   "en": "Where is it?",
   "noteHtml": "The verb <code>estar</code> says where something is: <code>estoy, estás, está, estamos, estáis, están</code>. <code>Hay</code> means \"there is\" or \"there are\".",
   "dialogue": [
    {
     "speaker": "Leo",
     "es": "Perdona, ¿dónde está la estación de metro?",
     "en": "Excuse me, where is the metro station?"
    },
